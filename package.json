{
  "name": "kenya-schools-directory",
  "version": "1.0.0",
  "private": true,
  "description": "Directory + CRM of every school in Kenya: levels, grades, population, contacts and outreach.",
  "scripts": {
    "dev": "python3 -m harvest serve",
    "harvest": "python3 -m harvest all",
    "harvest:base": "python3 -m harvest all --skip-crawl",
    "discover": "python3 -m harvest discover",
    "crawl": "python3 -m harvest crawl",
    "refresh": "python3 -m harvest crawl --stale-days 60",
    "stats": "python3 -m harvest stats",
    "test": "python3 -m unittest discover tests"
  }
}
